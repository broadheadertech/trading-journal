# ============================================================================
# Atlas — environment variables
# ----------------------------------------------------------------------------
# Copy to `.env.local` for local dev, and set the same keys in your host
# (Vercel → Project → Settings → Environment Variables) for production.
#
# NOTE ON SCOPE:
#   • Most vars below are Next.js vars (app + API routes) → .env.local / Vercel.
#   • ADMIN_USER_ID is read by Convex *functions* → set it in the Convex
#     dashboard (Settings → Environment Variables), not just .env.local.
# ============================================================================

# ── Core ────────────────────────────────────────────────────────────────────
# Public base URL of the deployed app (used for checkout success/cancel
# redirects). Use http://localhost:3000 locally.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Convex deployment URL (from `npx convex dev` / the Convex dashboard).
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ── Auth (Clerk) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── Admin ───────────────────────────────────────────────────────────────────
# The Clerk user id of the admin. NEXT_PUBLIC_* is the client-side check;
# ADMIN_USER_ID (same value) must ALSO be set in the Convex dashboard so
# server-side admin mutations (requireAdmin) work.
NEXT_PUBLIC_ADMIN_USER_ID=user_xxx
ADMIN_USER_ID=user_xxx

# ── Payments: Stripe (international card) ────────────────────────────────────
# Needed only if you use Stripe checkout. Each plan also needs a Stripe price
# id set on its subscriptionPlans row (stripePriceIdMonthly / ...Yearly).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Payments: PayMongo (PH e-wallets + card) ────────────────────────────────
# Required to collect GCash / GrabPay / Maya / card payments.
# 1. PayMongo dashboard → Developers → API Keys → Secret key (sk_test_ / sk_live_).
# 2. Developers → Webhooks → add endpoint  <NEXT_PUBLIC_APP_URL>/api/paymongo/webhook
#    subscribed to  checkout_session.payment.paid  and  payment.failed,
#    then copy its signing secret (whsk_...).
PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxx

# ── Misc ────────────────────────────────────────────────────────────────────
# Optional — enables the live world-news feed in World Monitoring.
NEWS_API_KEY=
